export ZDOTDIR="${XDG_CONFIG_HOME:-$HOME/.config}/zsh"

# fnm's default Node.js for every zsh, interactive or not: MCP servers and other subprocesses never read .zshrc,
# where conf.d/10-fnm.zsh sets fnm up in full. aliases/default is fnm's link to the default version.
() {
  local bin=${FNM_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/fnm}/aliases/default/bin
  [[ -d $bin ]] && (( ! $path[(Ie)$bin] )) && path=($bin $path)
  return 0
}
