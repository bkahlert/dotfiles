#!/usr/bin/env bash
# Purpose: Search recursively with ripgrep, excluding VCS directories and reminding users to call it directly.
# Usage:   grepr [<rg-option>...] <pattern> [<path>...]

if command -v rg >/dev/null 2>&1; then
  printf 'grepr: use rg directly\n' >&2
  exec rg --line-number --with-filename --context 5 --hidden --no-ignore \
    --glob '!**/.git/**' --glob '!**/.svn/**' --glob '!**/CVS/**' "$@"
fi

printf 'grepr: rg unavailable; using grep fallback\n' >&2
exec grep -rn -H -C 5 -I --exclude-dir={.git,.svn,CVS} --devices=skip "$@"
