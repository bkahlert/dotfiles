#!/usr/bin/env bash
# Purpose: Open explainshell.com for a command line.
# Usage:   explain [--] <command> [<arg>...]
#
# Everything from the first word on is the command being explained, so its
# own options need no escaping. Use `--` if the command itself starts with a
# dash.
#
# Examples:
#   explain tar -xzvf foo.tgz
#   explain find . -name '*.log' -mtime +7 -delete

set -euo pipefail

usage() { awk 'NR==1{next} /^#/{sub(/^# ?/,""); print; next} {exit}' "${BASH_SOURCE[0]}"; }
die()   { printf '%s: %s\nSee '\''%s --help'\''\n' "${0##*/}" "$1" "${0##*/}" >&2; exit 2; }

while (( $# )); do
  case $1 in
    -h|--help) usage; exit 0 ;;
    --)        shift; break ;;
    -?*)       die "unknown option: $1" ;;
    *)         break ;;
  esac
done
(( $# )) || { usage >&2; exit 2; }

# Percent-encodes byte by byte; a space becomes `+`, a literal plus %2B. The mask is for bash 3.2,
# which sign-extends bytes above 127.
urlencode() {
  local LC_ALL=C text=$1 char code i
  for ((i = 0; i < ${#text}; i++)); do
    char=${text:i:1}
    case $char in
      [A-Za-z0-9._~-]) printf '%s' "$char" ;;
      ' ')             printf '+' ;;
      *)               printf -v code '%d' "'$char"; printf '%%%02X' $((code & 255)) ;;
    esac
  done
}

url="https://explainshell.com/explain?cmd=$(urlencode "$*")"

if command -v open >/dev/null; then
  open "$url"
elif command -v xdg-open >/dev/null; then
  xdg-open "$url"
else
  printf '%s: no browser opener found (open, xdg-open)\n' "${0##*/}" >&2
  exit 1
fi
