#!/usr/bin/env bash
# Purpose: Prefer the real Docker CLI if installed; fall back to podman; error otherwise.
# Usage:   docker [<docker-cli-args>...]

set -euo pipefail

# Every copy of this wrapper run so far, this one included: a second copy on PATH
# (another ~/.local/bin, say) would otherwise exec this one back, forever.
export DOCKER_WRAPPERS="${DOCKER_WRAPPERS:+$DOCKER_WRAPPERS:}$0"

# Print the first executable <name> on PATH that is none of those wrappers.
# Compared by file identity (-ef), so a trailing slash, a relative entry or a
# symlinked directory cannot make the wrapper pick itself either.
find_other() {
  local dir candidate wrapper
  local IFS=:
  for dir in $PATH; do
    candidate="${dir:-.}/$1"
    [[ -f "$candidate" && -x "$candidate" ]] || continue
    for wrapper in $DOCKER_WRAPPERS; do
      [[ "$candidate" -ef "$wrapper" ]] && continue 2
    done
    printf '%s\n' "$candidate"
    return 0
  done
  return 1
}

if real=$(find_other docker); then
  exec "$real" "$@"
elif real=$(find_other podman); then
  exec "$real" "$@"
fi

printf 'docker: neither docker nor podman found on PATH\n' >&2
exit 127
