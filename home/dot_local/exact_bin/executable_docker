#!/usr/bin/env bash
# Purpose: Prefer the real Docker CLI if installed; fall back to podman; error otherwise.
# Usage:   docker [<docker-cli-args>...]

set -euo pipefail

# Print the first executable <name> on PATH that is not this script. Compared by
# file identity (-ef), so a trailing slash, a relative entry or a symlinked
# directory cannot make the wrapper pick itself and re-exec forever.
find_other() {
  local dir candidate
  local IFS=:
  for dir in $PATH; do
    candidate="${dir:-.}/$1"
    if [[ -f "$candidate" && -x "$candidate" && ! "$candidate" -ef "$0" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  return 1
}

if real=$(find_other docker); then
  exec "$real" "$@"
elif real=$(find_other podman); then
  exec "$real" "$@"
fi

printf 'docker: neither docker nor podman found on PATH\n' >&2
exit 127
