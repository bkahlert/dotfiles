#!/usr/bin/env bash
# Purpose: Send a macOS notification via osascript's `display notification`.
# Usage:   notify [--title <title>] [--subtitle <subtitle>] [--sound <sound>] [--] <message>...
#
# Several <message> words are joined with spaces. Sounds are looked up in
# ~/Library/Sounds and /System/Library/Sounds. Set DEBUG=1 to log invocations
# to ~/.notify.log.
#
# Options:
#   --title <title>         Notification title (default: Notification).
#   --subtitle <subtitle>   Second line under the title.
#   --sound <sound>         Sound name, e.g. Purr, Glass, Hero.
#   -h, --help              Show this help.
#
# Examples:
#   notify 'Build finished'
#   notify 'You have just been notified' --title '🎉 Congratulations' --sound Purr

set -euo pipefail

usage() { awk 'NR==1{next} /^#/{sub(/^# ?/,""); print; next} {exit}' "${BASH_SOURCE[0]}"; }
die()   { printf '%s: %s\nSee '\''%s --help'\''\n' "${0##*/}" "$1" "${0##*/}" >&2; exit 2; }

if [ "${DEBUG-}" ]; then
  printf 'Invocation: %b\n' "$*" >>~/.notify.log
fi

title=Notification
subtitle=''
sound=''
args=()
while (( $# )); do
  case $1 in
    -h|--help)    usage; exit 0 ;;
    --title)      title=${2?--title: missing value}; shift 2 ;;
    --title=*)    title=${1#*=}; shift ;;
    --subtitle)   subtitle=${2?--subtitle: missing value}; shift 2 ;;
    --subtitle=*) subtitle=${1#*=}; shift ;;
    --sound)      sound=${2?--sound: missing value}; shift 2 ;;
    --sound=*)    sound=${1#*=}; shift ;;
    --)           shift; args+=("$@"); break ;;
    -?*)          die "unknown option: $1" ;;
    *)            args+=("$1"); shift ;;
  esac
done
(( ${#args[@]} )) || { usage >&2; exit 2; }
message=${args[*]}

osascript - "$message" "$title" "$subtitle" "$sound" <<'APPLESCRIPT'
  on run {theNotification, theTitle, theSubtitle, theSound}
    if theSound is "" then
      display notification theNotification with title theTitle subtitle theSubtitle
    else
      display notification theNotification with title theTitle subtitle theSubtitle sound name theSound
    end if
  end run
APPLESCRIPT
