#!/usr/bin/env bash
# Purpose: Print a secret by name, read from whichever password manager this
#          machine uses: 1Password on ista, KeePassXC everywhere else.
# Usage:   secret-read <name>
#
# Arguments:
#   <name>       Item title, kept identical in both managers (e.g.
#                CONTEXT7_API_KEY, "GitLab Token"). The secret is the item's
#                password field.
#
# Examples:
#   secret-read CONTEXT7_API_KEY
#   token=$(secret-read "GitLab Token")

set -euo pipefail

usage() { awk 'NR==1{next} /^#/{sub(/^# ?/,""); print; next} {exit}' "${BASH_SOURCE[0]}"; }
die()   { printf '%s: %s\nSee '\''%s --help'\''\n' "${0##*/}" "$1" "${0##*/}" >&2; exit 2; }

readonly _KDBX="${HOME}/Library/Mobile Documents/com~apple~CloudDocs/Vault/choam.kdbx"
readonly _OP_VAULT="Employee"
# Bounds the prompt below. Callers fetch from conf.d on the interactive startup
# path, where an unbounded prompt wedges the terminal instead of failing.
readonly _PROMPT_TIMEOUT=120

args=()
while (( $# )); do
  case $1 in
    -h|--help) usage; exit 0 ;;
    --)        shift; args+=("$@"); break ;;
    -?*)       die "unknown option: $1" ;;
    *)         args+=("$1"); shift ;;
  esac
done
(( ${#args[@]} )) || { usage >&2; exit 2; }
(( ${#args[@]} == 1 )) || die "expected exactly one <name>"
name=${args[0]}

if [[ "${DOTFILES_CONTEXT:-}" == ista ]]; then
  exec op read --no-newline "op://${_OP_VAULT}/${name}/credential"
fi

command -v keepassxc-cli >/dev/null || {
  printf 'secret-read: keepassxc-cli not found (brew install --cask keepassxc)\n' >&2
  exit 1
}

[[ -f "$_KDBX" ]] || {
  printf 'secret-read: vault not found at %s\n' "$_KDBX" >&2
  printf 'secret-read: iCloud not synced? open KeePassXC to trigger a download\n' >&2
  exit 1
}

# Asked for on every call because keepassxc-cli cannot reuse a database already
# unlocked in the GUI — see keepassxreboot/keepassxc#12282. Callers are expected
# to cache the result rather than re-prompt.
master=$(osascript \
  -e "display dialog \"KeePassXC master password (for ${name})\" \
      default answer \"\" with hidden answer with title \"secret-read\" \
      buttons {\"Cancel\",\"OK\"} default button \"OK\" \
      giving up after ${_PROMPT_TIMEOUT}" \
  -e 'text returned of result') || {
  printf 'secret-read: cancelled\n' >&2
  exit 1
}

# --quiet silences keepassxc-cli's own diagnostics along with its prompt, so a
# wrong password would otherwise exit 1 with no output at all.
if ! secret=$(keepassxc-cli show --quiet --show-protected --attributes Password \
  "$_KDBX" "$name" <<<"$master"); then
  printf 'secret-read: could not read "%s" — wrong master password, or no such entry\n' "$name" >&2
  exit 1
fi

[[ -n "$secret" ]] || {
  printf 'secret-read: "%s" has an empty password field\n' "$name" >&2
  exit 1
}

printf '%s\n' "$secret"
