#!/usr/bin/env bash
# Purpose: Serve the current directory over HTTP, caching disabled.
# Usage:   serve [<http-server-option>...]

set -euo pipefail

# Pinned: npx runs this third-party code on every call; bump deliberately.
readonly HTTP_SERVER=http-server@14.1.1

port=$(pick-port) || { printf 'serve: no port available\n' >&2; exit 1; }
printf 'serve: http://localhost:%s\n' "$port" >&2
exec npx "$HTTP_SERVER" -c-1 -p "$port" "$@"
