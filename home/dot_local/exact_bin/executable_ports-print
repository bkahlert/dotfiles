#!/usr/bin/env bash
# Purpose: List every port something is listening on, with the owning process.
# Usage:   ports-print
#
# macOS: lsof over TCP listeners; without sudo only your own processes show.
# Linux: ss, falling back to netstat, over TCP and UDP.
#
# Options:
#   -h, --help   Show this help.

set -euo pipefail

usage() { awk 'NR==1{next} /^#/{sub(/^# ?/,""); print; next} {exit}' "${BASH_SOURCE[0]}"; }
die()   { printf '%s: %s\nSee '\''%s --help'\''\n' "${0##*/}" "$1" "${0##*/}" >&2; exit 2; }

while (( $# )); do
  case $1 in
    -h|--help) usage; exit 0 ;;
    *)         die "unknown argument: $1" ;;
  esac
done

case $OSTYPE in
  darwin*) exec lsof -nP -iTCP -sTCP:LISTEN ;;
  linux*)
    if command -v ss >/dev/null; then exec ss -tulnp; fi
    exec netstat -tulpn
    ;;
  *) printf '%s: unsupported OS: %s\n' "${0##*/}" "$OSTYPE" >&2; exit 1 ;;
esac
