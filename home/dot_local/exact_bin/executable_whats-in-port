#!/usr/bin/env bash
# Purpose: Show the processes bound to a TCP port, listeners and connections
#          alike.
# Usage:   whats-in-port <port>
#
# Without sudo only your own processes show. Exits 1 if nothing is bound.
#
# Examples:
#   whats-in-port 3000
#   COMMAND   PID           USER   FD   TYPE  DEVICE SIZE/OFF NODE NAME
#   node    25583 bjoern.kahlert   23u  IPv6  0x…        0t0  TCP *:3000 (LISTEN)

set -euo pipefail

usage() { awk 'NR==1{next} /^#/{sub(/^# ?/,""); print; next} {exit}' "${BASH_SOURCE[0]}"; }
die()   { printf '%s: %s\nSee '\''%s --help'\''\n' "${0##*/}" "$1" "${0##*/}" >&2; exit 2; }

args=()
while (( $# )); do
  case $1 in
    -h|--help) usage; exit 0 ;;
    --)        shift; args+=("$@"); break ;;
    -?*)       die "unknown option: $1" ;;
    *)         args+=("$1"); shift ;;
  esac
done
(( ${#args[@]} )) || { usage >&2; exit 2; }
(( ${#args[@]} == 1 )) || die "expected exactly one <port>"
port=${args[0]}
[[ $port =~ ^[0-9]+$ ]] || die "not a port number: $port"

lsof -nP -iTCP:"$port" || {
  printf '%s: nothing bound to port %s\n' "${0##*/}" "$port" >&2
  exit 1
}
