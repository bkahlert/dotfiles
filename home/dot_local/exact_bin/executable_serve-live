#!/usr/bin/env bash
# Purpose: Serve the current directory over HTTP with live reload.
# Usage:   serve-live [<live-server-option>...]

set -euo pipefail

# Pinned: npx runs this third-party code on every call; bump deliberately.
readonly LIVE_SERVER=live-server@1.2.2

port=$(pick-port) || { printf 'serve-live: no port available\n' >&2; exit 1; }
printf 'serve-live: http://localhost:%s\n' "$port" >&2
exec npx "$LIVE_SERVER" --port="$port" --no-browser "$@"
