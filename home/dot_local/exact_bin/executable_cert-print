#!/usr/bin/env bash
# Purpose: Print the leaf certificate a TLS server presents in human-readable
#          form (openssl x509 -text).
# Usage:   cert-print <domain> [<port>]
#
# Arguments:
#   <domain>     Host to connect to; also sent as the SNI server name.
#   <port>       TCP port (default: 443).
#
# Options:
#   -h, --help   Show this help.

set -euo pipefail

usage() { awk 'NR==1{next} /^#/{sub(/^# ?/,""); print; next} {exit}' "${BASH_SOURCE[0]}"; }
die()   { printf '%s: %s\nSee '\''%s --help'\''\n' "${0##*/}" "$1" "${0##*/}" >&2; exit 2; }

args=()
while (( $# )); do
  case $1 in
    -h|--help) usage; exit 0 ;;
    --)        shift; args+=("$@"); break ;;
    -?*)       die "unknown option: $1" ;;
    *)         args+=("$1"); shift ;;
  esac
done
(( ${#args[@]} >= 1 )) || die "domain missing"
(( ${#args[@]} <= 2 )) || die "too many arguments"
domain=${args[0]}
port=${args[1]:-443}

openssl s_client -showcerts -servername "$domain" -connect "$domain:$port" </dev/null 2>/dev/null \
  | openssl x509 -inform pem -noout -text
