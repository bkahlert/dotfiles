#!/usr/bin/env bash
# Purpose: Reclaim disk space by clearing caches, logs, and stale build artifacts on macOS.
# Usage:   cleanup [--apply] [--yes] [--sim-unused <days>]
#
# Options:
#   --apply               Perform the deletions. Without it, only report what would be deleted.
#   -y, --yes             Auto-accept risky prompts (still needs --apply to delete).
#   --sim-unused <days>   Delete iOS simulators and runtimes not booted for <days> days (default: 30).
#                         0 deletes every simulator that was booted at least once.
#   -h, --help            Show this help.
#
# Safe items (caches, logs, leftovers) are removed without asking. Risky items
# (backups, archives, whole dependency caches, simulators, IDE configs) are listed
# and confirmed one by one. The dry run never prompts; it reports both totals.
#
# Examples:
#   cleanup                            # report only
#   cleanup --apply                    # delete safe items, ask before the risky ones
#   cleanup --apply --yes              # delete everything without asking
#   cleanup --apply --sim-unused 7     # also drop simulators idle for a week

set -uo pipefail

[[ $(uname) == Darwin ]] || { printf 'cleanup: macOS only\n' >&2; exit 1; }

usage() { awk 'NR==1{next} /^#/{sub(/^# ?/,""); print; next} {exit}' "${BASH_SOURCE[0]}"; }
die()   { printf '%s: %s\nSee '\''%s --help'\''\n' "${0##*/}" "$1" "${0##*/}" >&2; exit 2; }

apply=false
assume_yes=false
sim_unused=30
while (( $# )); do
  case $1 in
    -h|--help)      usage; exit 0 ;;
    --apply)        apply=true; shift ;;
    -y|--yes)       assume_yes=true; shift ;;
    --sim-unused)   sim_unused=${2?--sim-unused: missing value}; shift 2 ;;
    --sim-unused=*) sim_unused=${1#*=}; shift ;;
    -?*)            die "unknown option: $1" ;;
    *)              die "unexpected argument: $1" ;;
  esac
done
[[ $sim_unused =~ ^[0-9]+$ ]] || die "--sim-unused: expected a number of days, got '$sim_unused'"

if [ -t 1 ]; then
  c_bold=$(tput bold); c_reset=$(tput sgr0); c_yellow=$(tput setaf 3)
  c_green=$(tput setaf 2); c_red=$(tput setaf 1); c_blue=$(tput setaf 4); c_gray=$(tput setaf 8)
else
  c_bold=''; c_reset=''; c_yellow=''; c_green=''; c_red=''; c_blue=''; c_gray=''
fi

step() { printf '\n%s⚙ %s%s\n' "$c_yellow" "$1" "$c_reset"; }
info() { printf '%sℹ%s %s\n' "$c_blue" "$c_reset" "$1"; }
ok()   { printf '%s✔%s %s\n' "$c_green" "$c_reset" "$1"; }
warn() { printf '%s%s!%s %s\n' "$c_bold" "$c_yellow" "$c_reset" "$1"; }
skip() { printf '%s▪%s %s\n' "$c_gray" "$c_reset" "$1"; }
item() { printf '  %s%s%s\n' "$c_gray" "$1" "$c_reset"; }

bytes_to_human() {
  local b=${1:-0} d='' s=0
  local S=(B KiB MiB GiB TiB PiB EiB ZiB YiB)
  while ((b >= 1024)); do
    d=$(printf ".%02d" $((b % 1024 * 100 / 1024)))
    b=$((b / 1024)); ((s++))
  done
  printf '%s%s %s' "$b" "$d" "${S[$s]}"
}

size_of() {
  local total=0 p sz
  for p in "$@"; do
    [[ -e $p ]] || continue
    sz=$(du -sk "$p" 2>/dev/null | awk '{print $1}')
    [[ -n $sz ]] && total=$((total + sz * 1024))
  done
  printf '%s' "$total"
}

# Dry-run totals: what goes without asking, and what waits behind a prompt.
reclaimable=0
reclaimable_risky=0

# Only called in apply mode; the dry run never reaches a prompt.
confirm() {
  $assume_yes && { info 'auto-yes'; return 0; }
  [ -t 0 ] || { info 'non-interactive: keeping'; return 1; }
  local reply=''
  read -r -p "$1 [y/N] " reply || return 1
  [[ $reply =~ ^[Yy]([Ee][Ss])?$ ]]
}

remove() {
  local use_sudo=$1; shift
  if $use_sudo; then sudo -n rm -rf "$@" 2>/dev/null; else rm -rf "$@" 2>/dev/null; fi
}

# clean <label> <risky:true|false> <sudo:true|false> <paths...>
clean() {
  local label=$1 risky=$2 use_sudo=$3; shift 3
  local existing=() p
  for p in "$@"; do [[ -e $p ]] && existing+=("$p"); done
  (( ${#existing[@]} )) || { skip "$label: nothing to clean"; return; }
  local bytes; bytes=$(size_of "${existing[@]}")
  info "$label: $(bytes_to_human "$bytes") across ${#existing[@]} path(s)"
  if $risky; then
    for p in "${existing[@]}"; do item "$p"; done
    if ! $apply; then
      reclaimable_risky=$((reclaimable_risky + bytes)); skip "$label: would ask"; return
    fi
    confirm "Delete $label?" || { skip "$label kept"; return; }
  elif ! $apply; then
    reclaimable=$((reclaimable + bytes)); skip "$label (dry-run)"; return
  fi
  if remove "$use_sudo" "${existing[@]}"; then
    ok "$label cleaned"
  else
    warn "$label: some paths could not be removed"
  fi
}

# run <label> <cmd...>: run a command in apply mode, announce it in the dry run.
run() {
  local label=$1; shift
  if ! $apply; then info "would run: $*"; return; fi
  if "$@" &>/dev/null; then ok "$label"; else warn "$label failed: $*"; fi
}

if $apply; then
  printf '%s%s⚠ APPLY MODE — destructive actions will run%s\n' "$c_bold" "$c_red" "$c_reset"
else
  printf '%s%s↗ DRY-RUN — no files will be deleted (use --apply to clean)%s\n' "$c_bold" "$c_blue" "$c_reset"
fi

if $apply; then
  if ! sudo -v; then
    warn 'sudo not granted; system-level steps will be skipped'
  else
    while true; do sudo -n true 2>/dev/null; sleep 60; kill -0 "$$" 2>/dev/null || exit; done &
    sudo_pid=$!
    trap 'kill "$sudo_pid" 2>/dev/null || true' EXIT
  fi
fi

old_avail=$(df -k / | tail -1 | awk '{print $4}')

# ---------- safe: paths ----------
# ~/.Trash is TCC-protected: without Full Disk Access the shell sees an empty
# directory. Finder sees the real thing and empties the trash of every volume.
step 'Trash (all volumes, via Finder)'
trash_count=$(osascript -e 'tell application "Finder" to count items of trash' 2>/dev/null || printf 0)
if (( trash_count == 0 )); then
  skip 'Trash: empty'
else
  trash_bytes=$(size_of "$HOME/.Trash")
  if (( trash_bytes )); then
    info "Trash: $trash_count item(s), $(bytes_to_human "$trash_bytes")"
    $apply || reclaimable=$((reclaimable + trash_bytes))
  else
    info "Trash: $trash_count item(s), size unknown without Full Disk Access"
  fi
  empty_trash() {
    osascript -e 'tell application "Finder"
      set warned to warns before emptying of trash
      set warns before emptying of trash to false
      empty trash
      set warns before emptying of trash to warned
    end tell'
  }
  run 'Trash emptied' empty_trash
fi

step 'System & diagnostic logs'
clean 'Logs' false true \
  /private/var/log/asl/*.asl \
  /Library/Logs/DiagnosticReports/* \
  /Library/Logs/Adobe/* \
  "$HOME/Library/Containers/com.apple.mail/Data/Library/Logs/Mail"/*

step 'JVM heap dumps in ~'
clean 'Heap dumps' false false "$HOME"/*.hprof

step 'Xcode DerivedData'
clean 'DerivedData' false false "$HOME/Library/Developer/Xcode/DerivedData"/*

step 'CocoaPods cache'
clean 'CocoaPods' false false "$HOME/Library/Caches/CocoaPods"/*

step 'pip cache'
clean 'pip' false false "$HOME/Library/Caches/pip"

step 'pyenv-virtualenv cache'
if [[ -n ${PYENV_VIRTUALENV_CACHE_PATH:-} ]]; then
  clean 'pyenv-virtualenv' false false "$PYENV_VIRTUALENV_CACHE_PATH"
else
  skip 'PYENV_VIRTUALENV_CACHE_PATH not set'
fi

user_tmp=$(getconf DARWIN_USER_TEMP_DIR 2>/dev/null || printf '%s' "${TMPDIR:-/tmp}")
user_tmp=${user_tmp%/}

step 'gcloud-login driver test leftovers (older than 1h)'
leftovers=()
while IFS= read -r p; do leftovers+=("$p"); done < <(
  find "$user_tmp" -maxdepth 1 -name 'gcloud-login-driver-test-*' -mmin +60 2>/dev/null
)
clean 'Driver test leftovers' false false "${leftovers[@]}"

# Chromium-based apps clone their bundle into <tmp>/../X/<bundle-id>.code_sign_clone
# for signature checks and remove it on exit. Crashed or killed runs leave them
# behind. A running app still uses its clone, so keep those.
step 'Code-sign clones of apps that are not running'
stale_clones=()
for clone in "${user_tmp%/T}/X"/*.code_sign_clone/code_sign_clone.*; do
  [[ -d $clone ]] || continue
  app=''
  for a in "$clone"/*.app; do [[ -e $a ]] && { app=${a##*/}; break; }; done
  [[ -n $app ]] && pgrep -qf "/$app/" && continue
  stale_clones+=("$clone")
done
clean 'Code-sign clones' false false "${stale_clones[@]}"

# ---------- safe: tool commands ----------
step 'Composer cache'
if command -v composer &>/dev/null; then
  run 'composer cache cleared' composer clearcache
else
  skip 'composer not installed'
fi

step 'Homebrew cleanup'
if command -v brew &>/dev/null; then
  brew_cache=$(brew --cache 2>/dev/null || true)
  if [[ -n $brew_cache && -e $brew_cache ]]; then
    bytes=$(size_of "$brew_cache")
    $apply || reclaimable=$((reclaimable + bytes))
    info "brew cache: $(bytes_to_human "$bytes")"
  fi
  run 'brew cleaned' brew cleanup --prune=all -s
else
  skip 'brew not installed'
fi

step 'RubyGems cleanup'
if command -v gem &>/dev/null; then
  run 'gem cleanup done' gem cleanup
else
  skip 'gem not installed'
fi

step 'npm cache'
if command -v npm &>/dev/null; then
  run 'npm cache cleared' npm cache clean --force
else
  skip 'npm not installed'
fi

step 'Yarn cache'
if command -v yarn &>/dev/null; then
  run 'yarn cache cleared' yarn cache clean --force
else
  skip 'yarn not installed'
fi

step 'uv cache'
if command -v uv &>/dev/null; then
  run 'uv cache cleared' uv cache clean
else
  skip 'uv not installed'
fi

step 'Containers: dangling images, stopped containers, unused volumes'
if command -v docker &>/dev/null && docker info &>/dev/null; then
  docker system df 2>/dev/null | while IFS= read -r line; do item "$line"; done
  run 'containers pruned' docker system prune -f
  run 'volumes pruned' docker volume prune -f
else
  skip 'docker/podman not installed or not running'
fi

# ---------- risky ----------
step 'iOS Mobile Applications archive'
clean 'iOS Mobile Applications' true false "$HOME/Music/iTunes/iTunes Media/Mobile Applications"/*

step 'iOS Device Backups (iPhone/iPad)'
clean 'iOS Device Backups' true false "$HOME/Library/Application Support/MobileSync/Backup"/*

step 'Xcode Archives (submission artifacts)'
clean 'Xcode Archives' true false "$HOME/Library/Developer/Xcode/Archives"/*

step 'Xcode iOS DeviceSupport (symbols; rebuilt when a device connects)'
clean 'iOS DeviceSupport' true false "$HOME/Library/Developer/Xcode/iOS DeviceSupport"/*

step 'Dropbox cache'
if [[ -d "$HOME/Dropbox/.dropbox.cache" ]]; then
  clean 'Dropbox cache' true true "$HOME/Dropbox/.dropbox.cache"/*
else
  skip 'Dropbox not installed'
fi

step 'Gradle caches (every dependency is downloaded again)'
if [[ -d "$HOME/.gradle/caches" ]]; then
  $apply && command -v gradle &>/dev/null && gradle --stop &>/dev/null
  clean 'Gradle caches' true false "$HOME/.gradle/caches"
else
  skip 'Gradle caches: nothing to clean'
fi

# Pruning inside the VM never shrinks the host disk image; recreating the
# machine does. Everything inside it (images, containers, volumes) is lost.
podman_recreate() {
  local name=$1 cpus=$2 mem=$3 disk=$4 rootful=$5 was_running=$6
  local init=(podman machine init --cpus "$cpus" --memory "$mem" --disk-size "$disk")
  [[ $rootful == true ]] && init+=(--rootful)
  $was_running && podman machine stop "$name" &>/dev/null
  podman machine rm -f "$name" &>/dev/null || { warn "podman machine $name: could not remove"; return; }
  info "podman machine $name: downloading a fresh image, this takes a minute"
  "${init[@]}" "$name" &>/dev/null || { warn "podman machine $name: init failed; run by hand: ${init[*]} $name"; return; }
  if $was_running; then
    podman machine start "$name" &>/dev/null || { warn "podman machine $name: recreated but failed to start"; return; }
  fi
  ok "podman machine $name recreated"
}

step 'Podman machine (recreate when its disk image exceeds 10 GiB; everything inside is lost)'
if ! command -v podman &>/dev/null; then
  skip 'podman not installed'
elif ! command -v jq &>/dev/null; then
  warn 'jq not installed; skipping podman machine'
else
  podman_seen=false
  while IFS= read -r name; do
    name=${name%\*}
    [[ -n $name ]] || continue
    podman_seen=true
    IFS=$'\t' read -r state rootful cpus mem disk confdir < <(podman machine inspect "$name" 2>/dev/null \
      | jq -r '.[0] | [.State, .Rootful, .Resources.CPUs, .Resources.Memory, .Resources.DiskSize, .ConfigDir.Path] | @tsv')
    image=$(jq -r '.ImagePath.Path // empty' "$confdir/$name.json" 2>/dev/null)
    [[ -n $image && -f $image ]] || { skip "podman machine $name: disk image not found"; continue; }
    bytes=$(size_of "$image")
    if (( bytes < 10 * 1024 * 1024 * 1024 )); then
      skip "podman machine $name: $(bytes_to_human "$bytes") on disk, keeping"; continue
    fi
    info "podman machine $name: $(bytes_to_human "$bytes") on disk ($state, ${cpus} CPUs, ${mem} MiB, ${disk} GiB disk)"
    item "$image"
    was_running=false; [[ $state == running ]] && was_running=true
    if ! $apply; then
      reclaimable_risky=$((reclaimable_risky + bytes)); skip "podman machine $name: would ask"
    elif confirm "Recreate podman machine $name? All images, containers and volumes inside are lost."; then
      podman_recreate "$name" "$cpus" "$mem" "$disk" "$rootful" "$was_running"
    else
      skip "podman machine $name kept"
    fi
  done < <(podman machine list --format '{{.Name}}' 2>/dev/null)
  $podman_seen || skip 'no podman machine'
fi

step 'Kotlin/Native toolchains (all but the newest)'
konan_old=()
konan_all=()
while IFS= read -r p; do [[ -d $p ]] && konan_all+=("$p"); done < <(
  printf '%s\n' "$HOME"/.konan/kotlin-native-prebuilt-* | sort -V
)
(( ${#konan_all[@]} > 1 )) && konan_old=("${konan_all[@]:0:${#konan_all[@]}-1}")
clean 'Kotlin/Native toolchains' true false "${konan_old[@]}"

step 'Playwright browsers (reinstall with: npx playwright install)'
clean 'Playwright browsers' true false "$HOME/Library/Caches/ms-playwright"/*

# JetBrains IDEs keep caches, configs and logs per <Product><year>.<n>. A folder
# is stale when no installed JetBrains app has that year.n version.
step 'JetBrains caches, configs and logs of uninstalled IDE versions'
jetbrains_versions=''
for app in /Applications/*.app "$HOME"/Applications/*.app; do
  plist=$app/Contents/Info.plist
  [[ -f $plist ]] || continue
  [[ $(plutil -extract CFBundleIdentifier raw -o - "$plist" 2>/dev/null) == com.jetbrains.* ]] || continue
  v=$(plutil -extract CFBundleShortVersionString raw -o - "$plist" 2>/dev/null)
  [[ $v =~ ^([0-9]{4}\.[0-9]+) ]] && jetbrains_versions+=" ${BASH_REMATCH[1]}"
done
jetbrains_stale=()
if [[ -n $jetbrains_versions ]]; then
  for d in "$HOME/Library/Caches/JetBrains"/* "$HOME/Library/Application Support/JetBrains"/* "$HOME/Library/Logs/JetBrains"/*; do
    [[ -d $d && ${d##*/} =~ ([0-9]{4}\.[0-9]+)$ ]] || continue
    [[ "$jetbrains_versions " == *" ${BASH_REMATCH[1]} "* ]] || jetbrains_stale+=("$d")
  done
  info "installed:${jetbrains_versions}"
  clean 'JetBrains stale versions' true false "${jetbrains_stale[@]}"
else
  skip 'no JetBrains IDE installed; cannot tell which versions are stale'
fi

step "iOS Simulators (not booted for ${sim_unused}+ days)"
if ! command -v xcrun &>/dev/null; then
  skip 'xcrun not installed'
elif ! command -v jq &>/dev/null; then
  warn 'jq not installed; skipping simulators'
else
  cutoff=$(date -u -v-"${sim_unused}d" +%Y-%m-%dT%H:%M:%SZ)
  devices_json=$(xcrun simctl list devices -j 2>/dev/null || printf '{"devices":{}}')

  # Devices whose runtime is gone can never boot again: safe.
  unavailable_bytes=$(jq '[.devices[][] | select(.isAvailable == false) | .dataPathSize] | add // 0' <<<"$devices_json")
  unavailable_count=$(jq '[.devices[][] | select(.isAvailable == false)] | length' <<<"$devices_json")
  if (( unavailable_count )); then
    info "unavailable simulators: $unavailable_count, $(bytes_to_human "$unavailable_bytes")"
    $apply || reclaimable=$((reclaimable + unavailable_bytes))
    run 'unavailable simulators deleted' xcrun simctl delete unavailable
  else
    skip 'unavailable simulators: none'
  fi

  # Devices booted at least once but not since the cutoff: risky. Never-booted
  # devices are Xcode's default fleet, hold no data and get recreated anyway.
  stale_tsv=$(jq -r --arg c "$cutoff" '
    .devices[][]
    | select(.isAvailable and .lastUsedAt != null and .lastUsedAt < $c)
    | [.udid, .dataPathSize, .lastUsedAt[:10], .name] | @tsv' <<<"$devices_json")
  if [[ -z $stale_tsv ]]; then
    skip "stale simulators: none"
  else
    stale_udids=(); stale_bytes=0
    while IFS=$'\t' read -r udid bytes last name; do
      stale_udids+=("$udid"); stale_bytes=$((stale_bytes + bytes))
      item "$(printf '%-10s %10s  %s  %s' "$last" "$(bytes_to_human "$bytes")" "$name" "$udid")"
    done <<<"$stale_tsv"
    info "stale simulators: ${#stale_udids[@]}, $(bytes_to_human "$stale_bytes")"
    if ! $apply; then
      reclaimable_risky=$((reclaimable_risky + stale_bytes)); skip 'stale simulators: would ask'
    elif confirm 'Delete these simulators?'; then
      xcrun simctl shutdown "${stale_udids[@]}" &>/dev/null || true
      run 'stale simulators deleted' xcrun simctl delete "${stale_udids[@]}"
    else
      skip 'stale simulators kept'
    fi
  fi

  # Runtimes (8 GiB disk images) with the same rule; never-used ones stay,
  # one of them is the SDK the installed Xcode builds against.
  runtimes_tsv=$(xcrun simctl runtime list -j 2>/dev/null | jq -r --arg c "$cutoff" '
    .[]
    | select(.deletable and .lastUsedAt != null and .lastUsedAt < $c)
    | [.identifier, .sizeBytes, .lastUsedAt[:10], (.runtimeIdentifier | split(".") | last), .build] | @tsv')
  if [[ -z $runtimes_tsv ]]; then
    skip 'stale runtimes: none'
  else
    stale_runtimes=(); runtime_bytes=0
    while IFS=$'\t' read -r id bytes last name build; do
      stale_runtimes+=("$id"); runtime_bytes=$((runtime_bytes + bytes))
      item "$(printf '%-10s %10s  %s (%s)' "$last" "$(bytes_to_human "$bytes")" "$name" "$build")"
    done <<<"$runtimes_tsv"
    info "stale runtimes: ${#stale_runtimes[@]}, $(bytes_to_human "$runtime_bytes")"
    if ! $apply; then
      reclaimable_risky=$((reclaimable_risky + runtime_bytes)); skip 'stale runtimes: would ask'
    elif confirm 'Delete these runtimes?'; then
      for id in "${stale_runtimes[@]}"; do run "runtime $id deleted" xcrun simctl runtime delete "$id"; done
    else
      skip 'stale runtimes kept'
    fi
  fi
fi

new_avail=$(df -k / | tail -1 | awk '{print $4}')
freed_kb=$((new_avail - old_avail))
if $apply; then
  freed=$((freed_kb < 0 ? 0 : freed_kb * 1024))
  printf '\n%s✔ Reclaimed: %s%s (APFS frees space lazily; the number may lag)\n' "$c_green" "$(bytes_to_human "$freed")" "$c_reset"
else
  printf '\n%s↗ Would reclaim: ~%s without asking, plus ~%s behind confirmations (estimated)%s\n' \
    "$c_blue" "$(bytes_to_human "$reclaimable")" "$(bytes_to_human "$reclaimable_risky")" "$c_reset"
  printf '%sRun with --apply to actually clean.%s\n' "$c_gray" "$c_reset"
fi
