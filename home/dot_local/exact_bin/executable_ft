#!/usr/bin/env bash
# Purpose: Recursive full-text search with 5 lines of context, skipping VCS
#          directories, devices and binary files.
# Usage:   ft [<grep-option>...] <pattern> [<path>...]
#
# Options pass straight through, so a pattern starting with a dash needs an
# explicit -e. -I skips binary files, which ugrep already does by default but
# BSD and GNU grep do not.

exec grep -rn -H -C 5 -I --exclude-dir={.git,.svn,CVS} --devices=skip "$@"
