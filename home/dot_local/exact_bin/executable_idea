#!/usr/bin/env bash
# Purpose: Wrapper for the IntelliJ IDEA CLI that locates the 'idea' binary
#          from common installation paths (JetBrains Toolbox, app bundle)
#          and delegates all arguments to it.
# Usage:   idea [<idea-cli-args>...]

set -euo pipefail

_find_idea() {
  # No PATH lookup here: this script is itself named 'idea' and lives on
  # PATH, so `command -v idea` would just find and re-exec itself forever.
  local candidates=(
    # JetBrains Toolbox — macOS
    "${HOME}/Library/Application Support/JetBrains/Toolbox/scripts/idea"
    # JetBrains Toolbox — Linux
    "${HOME}/.local/share/JetBrains/Toolbox/scripts/idea"
    # macOS app bundle — Ultimate Edition
    "/Applications/IntelliJ IDEA.app/Contents/MacOS/idea"
    # macOS app bundle — Community Edition
    "/Applications/IntelliJ IDEA CE.app/Contents/MacOS/idea"
  )

  for candidate in "${candidates[@]}"; do
    if [[ -x "${candidate}" ]]; then
      printf '%s' "${candidate}"
      return 0
    fi
  done

  return 1
}

idea_bin="$(_find_idea)" || {
  printf '%s: command not found\n' "$(basename "$0")" >&2
  printf '\n' >&2
  printf 'To set up the IntelliJ IDEA CLI, choose one of:\n' >&2
  printf '  Toolbox:   Settings → Configuration → Shell scripts location\n' >&2
  printf '  IntelliJ:  Tools → Create Command-line Launcher\n' >&2
  exit 127
}

exec "${idea_bin}" "$@"
