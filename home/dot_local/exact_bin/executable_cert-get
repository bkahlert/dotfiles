#!/usr/bin/env bash
# Purpose: Fetch the leaf certificate a TLS server presents and print it as
#          PEM. Invoked as `cert-download` (a symlink), it writes the PEM to
#          <domain>.pem in the current directory instead.
# Usage:   cert-get <domain> [<port>]
#          cert-download <domain> [<port>]
#
# Arguments:
#   <domain>     Host to connect to; also sent as the SNI server name.
#   <port>       TCP port (default: 443).
#
# Examples:
#   cert-get example.com
#   cert-get mail.example.com 993
#   cert-download example.com          # writes example.com.pem

set -euo pipefail

usage() { awk 'NR==1{next} /^#/{sub(/^# ?/,""); print; next} {exit}' "${BASH_SOURCE[0]}"; }
die()   { printf '%s: %s\nSee '\''%s --help'\''\n' "${0##*/}" "$1" "${0##*/}" >&2; exit 2; }

args=()
while (( $# )); do
  case $1 in
    -h|--help) usage; exit 0 ;;
    --)        shift; args+=("$@"); break ;;
    -?*)       die "unknown option: $1" ;;
    *)         args+=("$1"); shift ;;
  esac
done
(( ${#args[@]} )) || { usage >&2; exit 2; }
(( ${#args[@]} <= 2 )) || die "too many arguments"
domain=${args[0]}
port=${args[1]:-443}

fetch() {
  openssl s_client -showcerts -servername "$domain" -connect "$domain:$port" </dev/null 2>/dev/null \
    | openssl x509 -outform PEM
}

case ${0##*/} in
  cert-download) fetch >"$domain.pem" && printf '%s\n' "$domain.pem" ;;
  *) fetch ;;
esac
