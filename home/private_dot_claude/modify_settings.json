#!/usr/bin/env bash
# Purpose: Write Claude Code's settings.json from source state, keeping the keys Claude Code
#          changes on its own (model, effort level, per-model settings) as they are on this machine, and keeping
#          plugins/marketplaces installed only on this machine (this repo is public, so
#          company-internal marketplaces cannot live in source state).
# Usage:   Run by chezmoi on apply; receives the current file on stdin and prints the new content.

set -euo pipefail

current=$(cat)
[[ -n "$current" ]] || current='{}'

# Keys are emitted in the live file's order so an unchanged file yields no diff.
jq --indent 2 --argjson live "$current" '
  reduce ("model", "effortLevel", "modelSettings") as $k (.;
    if $live | has($k) then .[$k] = $live[$k] else del(.[$k]) end)
  # Source wins per entry, live-only entries survive: `claude plugin install` on this
  # machine is kept, while source state stays authoritative for what it does define.
  | reduce ("enabledPlugins", "extraKnownMarketplaces") as $k (.;
      if has($k) then .[$k] = (($live[$k] // {}) + .[$k]) else . end)
  | . as $merged
  | reduce (($live | keys_unsorted) + ($merged | keys_unsorted))[] as $k ({};
      if ($merged | has($k)) and (has($k) | not) then .[$k] = $merged[$k] else . end)
' <<'SETTINGS'
{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "ENABLE_PROMPT_CACHING_1H": "1",
    "CLAUDE_CODE_DISABLE_ALTERNATE_SCREEN": "1"
  },
  "permissions": {
    "allow": [
      "Bash(date:*)",
      "Bash(echo:*)",
      "Bash(cat:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(wc:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(sort:*)",
      "Bash(grep:*)",
      "Bash(tr:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git tag:*)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline"
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "chrome-devtools-mcp@claude-plugins-official": true,
    "vueuse-functions@vueuse-skills": true,
    "frontend-design@claude-plugins-official": true,
    "context7@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "chrome-devtools-plugins": {
      "source": {
        "source": "github",
        "repo": "ChromeDevTools/chrome-devtools-mcp"
      }
    },
    "vueuse-skills": {
      "source": {
        "source": "github",
        "repo": "vueuse/skills"
      }
    }
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "theme": "auto",
  "outputStyle": "Concise"
}
SETTINGS
