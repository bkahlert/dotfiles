#!/usr/bin/env python3
# Purpose: Render the Claude Code status line from the session JSON on stdin.
# Usage:   statusline [--nerd-fonts | --no-nerd-fonts] [--preview]
#
# Options:
#   --nerd-fonts      Force Nerd Font icons (overrides detection and NERD_FONTS).
#   --no-nerd-fonts   Force emoji fallbacks (overrides detection and NERD_FONTS).
#   --preview         Read the sample input of tests/claude/test_statusline.py in the dotfiles
#                     repo (chezmoi source-path) instead of stdin.
#   -h, --help        Show this help.
#
# Examples:
#   statusline --preview --nerd-fonts      # the sample session with Nerd Font icons
#   statusline --preview --no-nerd-fonts   # the same with emoji fallbacks
#
# Configured in ~/.claude/settings.json as statusLine.command.
# Writes the latest raw input to claude-statusline-input.json in Python's temporary
# directory (TMPDIR when set), with owner-only permissions.
# Requires Python >= 3.9 (standard library only).

import json
import math
import os
import shutil
import subprocess
import sys
import tempfile
import time
from pathlib import Path
from typing import Callable, NamedTuple

sys.path.insert(0, str(Path.home() / ".local" / "share"))

from statusline_render import render_parts

DIM, YELLOW, RED, RESET = "\033[2m", "\033[33m", "\033[31m", "\033[0m"
RATE_LIMIT_URL = "https://console.anthropic.com/settings/limits"

# (warn, error) lower bounds
USAGE_THRESHOLDS = (50, 75)
COST_THRESHOLDS_CENTS = (500, 1000)

SUPERSCRIPT = str.maketrans("0123456789dehimprx.", "⁰¹²³⁴⁵⁶⁷⁸⁹ᵈᵉʰⁱᵐᵖʳˣ·")


# ── Icons ──────────────────────────────────────────────────

# Context bar: left cap, 8 middle segments, right cap, each as (empty, full).
BAR = [("\uee00", "\uee03"), *[("\uee01", "\uee04")] * 8, ("\uee02", "\uee05")]

# (upper bound exclusive, glyph)
CIRCLES = [(12, "○"), (37, "◔"), (62, "◑"), (87, "◕"), (math.inf, "●")]


def bar(pct):
    # each segment covers 10 points and fills at its midpoint
    return "".join(full if pct >= 5 + 10 * i else empty for i, (empty, full) in enumerate(BAR))


def circle(pct):
    return next(glyph for bound, glyph in CIRCLES if pct < bound)


class Icons(NamedTuple):
    session: str
    model: str
    agent: str
    gauge: Callable[[int], str]
    tokens: str
    clock: str
    calendar: str
    restart: str


# tokens and restart are blank on purpose; their parts render without an icon.
NERD_ICONS = Icons(
    session="\uf292",
    model="\ue28c",
    agent="\U000f06a9",
    gauge=bar,
    tokens="",
    clock="\uf017",
    calendar="\uf272",
    restart="",
)

# U+FE0E on characters listed in Unicode's emoji-variation-sequences.txt keeps them monochrome.
TEXT_ICONS = Icons(
    session="#",
    model="⚙\ufe0e",
    agent="웃",
    gauge=circle,
    tokens="",
    clock="⏱\ufe0e",
    calendar="⧗\ufe0e",
    restart="",
)


# ── Nerd Font detection ────────────────────────────────────

def nerd_fonts_supported(override):
    """Flag, then NERD_FONTS, then a cached probe of the installed fonts."""
    for forced in (override, os.environ.get("NERD_FONTS")):
        if forced in ("0", "1"):
            return forced == "1"
    cache = Path(os.environ.get("XDG_CACHE_HOME") or Path.home() / ".cache") / "claude" / "nerd-font-support"
    try:
        if not cache.is_file() or fonts_changed_since(cache):
            cache.parent.mkdir(parents=True, exist_ok=True)
            cache.write_text("1" if nerd_fonts_installed() else "0")
        return cache.read_text().strip() == "1"
    except OSError:
        return nerd_fonts_installed()


def fonts_changed_since(path):
    """Installing or removing a font changes the mtime of the directory it lands in, which may be a subdirectory."""
    since = path.stat().st_mtime_ns
    return any(Path(directory).stat().st_mtime_ns > since
               for root in font_directories() for directory, _, _ in os.walk(root))


def font_directories():
    if sys.platform == "darwin":
        return [Path.home() / "Library/Fonts", Path("/Library/Fonts")]
    data = Path(os.environ.get("XDG_DATA_HOME") or Path.home() / ".local/share")
    return [data / "fonts", Path.home() / ".fonts", Path("/usr/local/share/fonts"), Path("/usr/share/fonts")]


def nerd_fonts_installed():
    if sys.platform == "darwin":
        for directory in font_directories():
            if directory.is_dir() and any("nerd" in entry.name.lower() for entry in directory.iterdir()):
                return True
    if shutil.which("fc-list"):
        fonts = subprocess.run(["fc-list"], capture_output=True, text=True).stdout
        return "nerd font" in fonts.lower()
    return False


# ── Input ──────────────────────────────────────────────────

def dump_input(text):
    destination = Path(tempfile.gettempdir()) / "claude-statusline-input.json"
    dump = tempfile.NamedTemporaryFile(
        mode="w", encoding="utf-8", dir=destination.parent, prefix=".claude-statusline-", delete=False)
    try:
        with dump:
            dump.write(text)
        Path(dump.name).replace(destination)
    finally:
        Path(dump.name).unlink(missing_ok=True)


def read_session(text):
    try:
        session = json.loads(text)
    except ValueError:
        return {}
    return session if isinstance(session, dict) else {}


def field(value, *path):
    for key in path:
        value = value.get(key) if isinstance(value, dict) else None
    return value


def number(value):
    return value if isinstance(value, (int, float)) and not isinstance(value, bool) else None


def configured_model():
    for name in ("settings.local.json", "settings.json"):
        try:
            model = field(json.loads((Path.home() / ".claude" / name).read_text()), "model")
        except (OSError, ValueError):
            continue
        if isinstance(model, str) and model:
            return model
    return ""


# ── Formatting ─────────────────────────────────────────────

def severity(value, thresholds):
    warn, error = thresholds
    return RED if value >= error else YELLOW if value >= warn else DIM


def format_tokens(count):
    if count >= 1_000_000:
        return f"{count / 1_000_000:g}m"
    if count >= 1000:
        return f"{count / 1000:g}k"
    return str(int(count))


def resets_in(epoch):
    delta = epoch - int(time.time())
    if delta <= 0:
        text = "expired"
    elif delta < 3600:
        text = f"{int(delta // 60)}m"
    elif delta < 172800:
        text = f"{delta / 3600:.1f}h"
    else:
        text = f"{delta / 86400:.1f}d"
    return text.translate(SUPERSCRIPT)


def link(url, text):
    return f"\033]8;;{url}\033\\{text}\033]8;;\033\\"


# ── Parts ──────────────────────────────────────────────────

def part_session(session, icons):
    session_id = (field(session, "session_id") or "")[:8]
    if not session_id:
        return ""
    name = field(session, "session_name") or ""
    text = f"{icons.session} {session_id}{':' + name if name else ''}"
    path = field(session, "transcript_path") or ""
    return link(f"file://{path}", text) if path else text


def part_model(session, icons, configured):
    model = field(session, "model", "id")
    model = "?" if model is None else model
    if not configured:
        return f"{icons.model} {model}"
    # settings may use short names ("haiku") or full IDs ("claude-haiku-4-5"); match both ways
    a, b = model.lower(), configured.lower()
    style = DIM if a in b or b in a else YELLOW
    return f"{style}{icons.model} {model}{RESET}"


def part_agent(session, icons):
    name = field(session, "agent", "name") or ""
    return f"{icons.agent} {name}" if name else ""


def part_context(session, icons):
    window = field(session, "context_window")
    used = number(field(window, "used_percentage"))
    pct = 0 if used is None else math.floor(used)
    style = severity(pct, USAGE_THRESHOLDS)
    out = f"{style}{icons.gauge(pct)} {pct}%{RESET}"
    size = number(field(window, "context_window_size"))
    if size is not None:
        tokens = f" {icons.tokens}" if icons.tokens else ""
        out += f" {style}╱{format_tokens(size)}{tokens}{RESET}"
    return out


def part_cost(session):
    usd = number(field(session, "cost", "total_cost_usd"))
    if usd is None:
        return ""
    return f"{severity(int(usd * 100), COST_THRESHOLDS_CENTS)}${usd:.2f}{RESET}"


def part_rate_limit(limit, icon, restart):
    used = number(field(limit, "used_percentage"))
    if used is None:
        return ""
    pct = math.floor(used)
    out = f"{severity(pct, USAGE_THRESHOLDS)}{icon} {pct}%"
    resets_at = number(field(limit, "resets_at"))
    if resets_at is not None:
        out += f" {restart}{resets_in(resets_at)}"
    return link(RATE_LIMIT_URL, out + RESET)


# ── Entry point ────────────────────────────────────────────

def usage():
    for line in Path(__file__).read_text().splitlines()[1:]:
        if not line.startswith("#"):
            break
        print(line[2:] if line.startswith("# ") else line[1:])


def die(message):
    name = Path(sys.argv[0]).name
    print(f"{name}: {message}\nSee '{name} --help'", file=sys.stderr)
    sys.exit(2)


def parse_args(args):
    """Return the Nerd Font override ("0", "1" or None) and whether to preview."""
    override, preview = None, False
    for arg in args:
        if arg in ("-h", "--help"):
            usage()
            sys.exit(0)
        elif arg == "--nerd-fonts":
            override = "1"
        elif arg == "--no-nerd-fonts":
            override = "0"
        elif arg == "--preview":
            preview = True
        elif arg.startswith("-"):
            die(f"unknown option: {arg}")
        else:
            die(f"unexpected argument: {arg}")
    return override, preview


def preview_input():
    source = subprocess.run(["chezmoi", "source-path"], stdout=subprocess.PIPE, text=True)
    if source.returncode:
        sys.exit(1)
    repo = Path(source.stdout.strip()).parent
    sample = subprocess.run(["uv", "run", "--locked", "tests/claude/test_statusline.py", "--print-input"],
                            cwd=repo, stdout=subprocess.PIPE, text=True)
    return sample.stdout


def main(args):
    override, preview = parse_args(args)
    text = preview_input() if preview else sys.stdin.read()
    dump_input(text)
    session = read_session(text)
    icons = NERD_ICONS if nerd_fonts_supported(override) else TEXT_ICONS
    limits = field(session, "rate_limits")
    parts = [
        part_session(session, icons),
        part_model(session, icons, configured_model()),
        part_agent(session, icons),
        part_context(session, icons),
        part_cost(session),
        part_rate_limit(field(limits, "five_hour"), icons.clock, icons.restart),
        part_rate_limit(field(limits, "seven_day"), icons.calendar, icons.restart),
    ]
    print(render_parts(parts))


if __name__ == "__main__":
    main(sys.argv[1:])
