#!/usr/bin/env python3
# Purpose: Render the Claude Code status line from the session JSON on stdin.
# Usage:   statusline [--nerd-fonts | --no-nerd-fonts] [--preview]
#
# Options:
#   --nerd-fonts      Force Nerd Font icons (overrides detection and NERD_FONTS).
#   --no-nerd-fonts   Force emoji fallbacks (overrides detection and NERD_FONTS).
#   --preview         Read the sample input of tests/claude/test_statusline.py in the dotfiles
#                     repo (chezmoi source-path) instead of stdin.
#   -h, --help        Show this help.
#
# Examples:
#   statusline --preview --nerd-fonts      # the sample session with Nerd Font icons
#   statusline --preview --no-nerd-fonts   # the same with emoji fallbacks
#
# Configured in ~/.claude/settings.json as statusLine.command.
# Requires Python >= 3.9 (standard library only).

import json
import math
import os
import shutil
import subprocess
import sys
import time
from pathlib import Path

DIM, YELLOW, RED, RESET = "\033[2m", "\033[33m", "\033[31m", "\033[0m"
SEPARATOR = " · "
RATE_LIMIT_URL = "https://console.anthropic.com/settings/limits"
COST_WARN_CENTS = 500
COST_ERR_CENTS = 1000

# (Nerd Font glyph, text-variant fallback). The fallbacks use U+FE0E on characters listed in
# Unicode's emoji-variation-sequences.txt, which keeps them monochrome.
SESSION = ("", "#")
MODEL = ("", "⚙︎")
AGENT = ("\U000f06a9", "웃")
TOKENS = ("", "")
CLOCK = ("", "⏱︎")
CALENDAR = ("", "⧗︎")
RESTART = ("", "")

# Context bar (Nerd Font): left cap, 8 middle segments, right cap, each as (empty, full).
BAR_LEFT = ("\U0000ee00", "\U0000ee03")
BAR_MIDDLE = ("\U0000ee01", "\U0000ee04")
BAR_RIGHT = ("\U0000ee02", "\U0000ee05")
BAR = [BAR_LEFT, *[BAR_MIDDLE] * 8, BAR_RIGHT]

# Fallback circle by context usage: (upper bound exclusive, glyph).
CIRCLES = [(12, "○"), (37, "◔"), (62, "◑"), (87, "◕")]
CIRCLE_FULL = "●"

SUPERSCRIPT = str.maketrans({
    **dict(zip("0123456789", "⁰¹²³⁴⁵⁶⁷⁸⁹")),
    **dict(zip("dehimprx.", "ᵈᵉʰⁱᵐᵖʳˣ·")),
})


def usage():
    for line in Path(__file__).read_text().splitlines()[1:]:
        if not line.startswith("#"):
            break
        print(line[2:] if line.startswith("# ") else line[1:])


def die(message):
    name = Path(sys.argv[0]).name
    print(f"{name}: {message}\nSee '{name} --help'", file=sys.stderr)
    sys.exit(2)


# ── Nerd Font detection ────────────────────────────────────

def nerd_fonts_supported(override):
    """Flag, then NERD_FONTS, then a cached probe of the installed fonts."""
    for forced in (override, os.environ.get("NERD_FONTS")):
        if forced in ("0", "1"):
            return forced == "1"
    cache = Path(os.environ.get("XDG_CACHE_HOME") or Path.home() / ".cache") / "claude" / "nerd-font-support"
    if not cache.is_file():
        cache.parent.mkdir(parents=True, exist_ok=True)
        cache.write_text("1" if nerd_fonts_installed() else "0")
    return cache.read_text() == "1"


def nerd_fonts_installed():
    if sys.platform == "darwin":
        for directory in (Path.home() / "Library/Fonts", Path("/Library/Fonts")):
            if directory.is_dir() and any("nerd" in entry.name.lower() for entry in directory.iterdir()):
                return True
    if shutil.which("fc-list"):
        fonts = subprocess.run(["fc-list"], capture_output=True, text=True).stdout
        return "nerd font" in fonts.lower()
    return False


# ── Input ──────────────────────────────────────────────────

def read_session(text):
    try:
        session = json.loads(text)
    except ValueError:
        return {}
    return session if isinstance(session, dict) else {}


def field(session, *path):
    for key in path:
        session = session.get(key) if isinstance(session, dict) else None
    return session


def number(value):
    return value if isinstance(value, (int, float)) and not isinstance(value, bool) else None


def configured_model():
    for name in ("settings.local.json", "settings.json"):
        try:
            model = field(json.loads((Path.home() / ".claude" / name).read_text()), "model")
        except (OSError, ValueError):
            continue
        if isinstance(model, str) and model:
            return model
    return ""


# ── Formatting ─────────────────────────────────────────────

def usage_style(pct):
    return RED if pct >= 75 else YELLOW if pct >= 50 else DIM


def superscript(text):
    return text.translate(SUPERSCRIPT)


def format_tokens(count):
    if count >= 1_000_000:
        return f"{count / 1_000_000:g}m"
    if count >= 1000:
        return f"{count / 1000:g}k"
    return str(int(count))


def resets_in(epoch):
    epoch = number(epoch)
    if epoch is None:
        return ""
    delta = epoch - int(time.time())
    if delta <= 0:
        raw = "expired"
    elif delta < 3600:
        raw = f"{int(delta // 60)}m"
    elif delta < 172800:
        raw = f"{delta / 3600:.1f}h"
    else:
        raw = f"{delta / 86400:.1f}d"
    return superscript(raw)


def link(url, text):
    return f"\033]8;;{url}\033\\{text}\033]8;;\033\\"


# ── Parts ──────────────────────────────────────────────────

def part_session(session, icon):
    session_id = (field(session, "session_id") or "")[:8]
    if not session_id:
        return ""
    name = field(session, "session_name") or ""
    text = f"{icon(SESSION)} {session_id}{':' + name if name else ''}"
    path = field(session, "transcript_path") or ""
    return link(f"file://{path}", text) if path else text


def part_model(session, icon, configured):
    model = field(session, "model", "id")
    model = "?" if model is None else model
    style = ""
    if configured:
        # settings may use short names ("haiku") or full IDs ("claude-haiku-4-5"); match both ways
        a, b = model.lower(), configured.lower()
        style = DIM if a in b or b in a else YELLOW
    return f"{style}{icon(MODEL)} {model}{RESET if style else ''}"


def part_agent(session, icon):
    name = field(session, "agent", "name") or ""
    return f"{icon(AGENT)} {name}" if name else ""


def part_context(session, icon, nerd):
    used = number(field(session, "context_window", "used_percentage"))
    pct = math.floor(used) if used is not None else 0
    style = usage_style(pct)
    if nerd:
        # each segment covers 10 points and fills at its midpoint
        glyph = "".join(full if pct >= 5 + 10 * i else empty for i, (empty, full) in enumerate(BAR))
    else:
        glyph = next((circle for bound, circle in CIRCLES if pct < bound), CIRCLE_FULL)
    out = f"{style}{glyph} {pct}%{RESET}"
    size = number(field(session, "context_window", "context_window_size"))
    if size is not None:
        tokens = icon(TOKENS)
        out += f" {style}╱{format_tokens(size)}{' ' + tokens if tokens else ''}{RESET}"
    return out


def part_cost(session):
    usd = number(field(session, "cost", "total_cost_usd"))
    if usd is None:
        return ""
    cents = int(usd * 100)
    style = RED if cents >= COST_ERR_CENTS else YELLOW if cents >= COST_WARN_CENTS else DIM
    return f"{style}${usd:.2f}{RESET}"


def part_rate_limit(session, window, glyphs, icon):
    used = number(field(session, "rate_limits", window, "used_percentage"))
    if used is None:
        return ""
    pct = math.floor(used)
    out = f"{usage_style(pct)}{icon(glyphs)} {pct}%"
    reset = resets_in(field(session, "rate_limits", window, "resets_at"))
    if reset:
        out += f" {icon(RESTART)}{reset}"
    return link(RATE_LIMIT_URL, out + RESET)


# ── Entry point ────────────────────────────────────────────

def preview_input():
    source = subprocess.run(["chezmoi", "source-path"], capture_output=True, text=True)
    if source.returncode:
        sys.exit(1)
    repo = Path(source.stdout.strip()).parent
    sample = subprocess.run(["uv", "run", "--locked", "tests/claude/test_statusline.py", "--print-input"],
                            cwd=repo, capture_output=True, text=True)
    return sample.stdout


def main(args):
    override, preview = None, False
    for arg in args:
        if arg in ("-h", "--help"):
            return usage()
        elif arg == "--nerd-fonts":
            override = "1"
        elif arg == "--no-nerd-fonts":
            override = "0"
        elif arg == "--preview":
            preview = True
        elif arg.startswith("-"):
            die(f"unknown option: {arg}")
        else:
            die(f"unexpected argument: {arg}")

    session = read_session(preview_input() if preview else sys.stdin.read())
    nerd = nerd_fonts_supported(override)

    def icon(glyphs):
        return glyphs[0] if nerd else glyphs[1]

    parts = [
        part_session(session, icon),
        part_model(session, icon, configured_model()),
        part_agent(session, icon),
        part_context(session, icon, nerd),
        part_cost(session),
        part_rate_limit(session, "five_hour", CLOCK, icon),
        part_rate_limit(session, "seven_day", CALENDAR, icon),
    ]
    print(SEPARATOR.join(part for part in parts if part))


if __name__ == "__main__":
    main(sys.argv[1:])
