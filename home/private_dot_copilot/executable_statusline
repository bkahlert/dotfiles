#!/usr/bin/env python3
# Purpose: Render a Claude-style status line from Copilot session JSON on stdin.
# Usage:   statusline [--nerd-fonts | --no-nerd-fonts] [--preview]
#
# Options:
#   --nerd-fonts      Force Nerd Font icons (overrides detection and NERD_FONTS).
#   --no-nerd-fonts   Force Unicode fallbacks (overrides detection and NERD_FONTS).
#   --preview         Render the sample Copilot session from the dotfiles repository instead of stdin.
#   -h, --help        Show this help.
#
# Example:
#   ~/.copilot/statusline --preview --nerd-fonts
#
# Configured in ~/.copilot/settings.json as statusLine.command.
# Writes the latest raw input to copilot-statusline-input.json in Python's temporary
# directory (TMPDIR when set), with owner-only permissions.
# Agent, quota, effort and sandbox stay in the native footer: Copilot omits their
# fields from the command input. All footer options remain enabled.
# Requires Python >= 3.9 (standard library only).

import json
import math
import subprocess
import sys
import tempfile
from pathlib import Path

script_dir = Path(__file__).absolute().parent
shared_dir = (script_dir.parent / "dot_local" / "share"
              if script_dir.name == "private_dot_copilot"
              else Path.home() / ".local" / "share")
sys.path.insert(0, str(shared_dir))

from agent_statusline import part_session, render_parts, select_icons

DIM, YELLOW, RED, RESET = "\033[2m", "\033[33m", "\033[31m", "\033[0m"


def dump_input(text):
  destination = Path(tempfile.gettempdir()) / "copilot-statusline-input.json"
  dump = tempfile.NamedTemporaryFile(
    mode="w", encoding="utf-8", dir=destination.parent, prefix=".copilot-statusline-", delete=False)
  try:
    with dump:
      dump.write(text)
    Path(dump.name).replace(destination)
  finally:
    Path(dump.name).unlink(missing_ok=True)


def read_status(text):
  try:
    status = json.loads(text)
  except ValueError:
    return {}
  return status if isinstance(status, dict) else {}


def field(value, *path):
  for key in path:
    value = value.get(key) if isinstance(value, dict) else None
  return value


def number(value):
  return value if isinstance(value, (int, float)) and not isinstance(value, bool) else None


def style(text, color=DIM):
  return f"{color}{text}{RESET}"


def severity(value):
  return RED if value >= 75 else YELLOW if value >= 50 else DIM


def format_tokens(count):
  if count >= 1_000_000:
    return f"{count / 1_000_000:g}m"
  if count >= 1000:
    return f"{count / 1000:g}k"
  return str(int(count))


def part_model(status, icons):
  model = field(status, "model", "display_name")
  if not isinstance(model, str) or not model:
    model = field(status, "model", "id")
  return f"{icons.model} {model if isinstance(model, str) and model else '?'}"


def part_context(status, icons):
  used = number(field(status, "context_window", "current_context_used_percentage"))
  if used is None:
    used = number(field(status, "context_window", "used_percentage"))
  pct = 0 if used is None else math.floor(used)
  color = severity(pct)
  out = [style(f"{icons.gauge(pct)} {pct}%", color)]
  size = number(field(status, "context_window", "displayed_context_limit"))
  if size is None:
    size = number(field(status, "context_window", "context_window_size"))
  if size is not None:
    out.append(style(f"╱{format_tokens(size)}", color))
  return " ".join(out)


def part_cost(status):
  ai_used = field(status, "ai_used", "formatted")
  return style(f"{ai_used} AIC") if isinstance(ai_used, str) and ai_used else ""


def part_indicators(status, icons):
  parts = []
  if field(status, "remote", "connected") is True:
    parts.append(style(f"{icons.remote} remote"))
  if field(status, "allow_all_enabled") is True:
    parts.append(style(f"{icons.yolo} YOLO"))
  return parts


def usage():
  for line in Path(__file__).read_text().splitlines()[1:]:
    if not line.startswith("#"):
      break
    print(line[2:] if line.startswith("# ") else line[1:])


def die(message):
  name = Path(sys.argv[0]).name
  print(f"{name}: {message}\nSee '{name} --help'", file=sys.stderr)
  sys.exit(2)


def parse_args(args):
  override, preview = None, False
  for arg in args:
    if arg in ("-h", "--help"):
      usage()
      sys.exit(0)
    elif arg == "--preview":
      preview = True
    elif arg == "--nerd-fonts":
      override = "1"
    elif arg == "--no-nerd-fonts":
      override = "0"
    elif arg.startswith("-"):
      die(f"unknown option: {arg}")
    else:
      die(f"unexpected argument: {arg}")
  return override, preview


def preview_input():
  source = subprocess.run(["chezmoi", "source-path"], capture_output=True, text=True)
  if source.returncode:
    sys.stderr.write(source.stderr)
    sys.exit(source.returncode)
  repo = Path(source.stdout.strip()).parent
  sample = subprocess.run(
    ["uv", "run", "--locked", "tests/copilot/test_statusline.py", "--print-input"],
    cwd=repo,
    capture_output=True,
    text=True,
  )
  if sample.returncode:
    sys.stderr.write(sample.stderr)
    sys.exit(sample.returncode)
  return sample.stdout


def main():
  override, preview = parse_args(sys.argv[1:])
  text = preview_input() if preview else sys.stdin.read()
  dump_input(text)
  status = read_status(text)
  icons = select_icons(override)
  session_id = field(status, "session_id")
  name = field(status, "session_name")
  transcript = field(status, "transcript_path")
  parts = [
    part_session(
      session_id if isinstance(session_id, str) else None,
      name if isinstance(name, str) else None,
      f"file://{transcript}" if isinstance(transcript, str) and transcript else None,
      override=override,
    ),
    part_model(status, icons),
    part_context(status, icons),
    part_cost(status),
    *part_indicators(status, icons),
  ]
  print(render_parts(parts))


if __name__ == "__main__":
  main()
