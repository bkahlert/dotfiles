{
  "model": "auto",
  "banner": "never",
  "contextManagementTools": true,
  "includeCoAuthoredBy": false,
  "memory": false,
  "showTimestamps": false,
  "transcriptView": "concise",
  "terminalProgress": true,
  "terminalNotifications": true,
  "updateTerminalTitle": true,
  "statusLine": {
    "type": "command",
    "command": "~/.copilot/statusline",
    "padding": 1
  },
  "dynamicRetrieval": {
    "skills": true,
    "mcp": true
  },
  "footer": {
    "showAgent": false,
    "showAiUsed": false,
    "showBranch": true,
    "showCiStatus": true,
    "showCodeChanges": false,
    "showContextWindow": false,
    "showCustom": true,
    "showDirectory": true,
    "showModelEffort": false,
    "showPullRequest": true,
    "showQuota": true,
    "showSandbox": true,
    "showSchedules": false,
    "showUsername": false,
    "showYolo": false
  },
  "ide": {
    "autoConnect": true
  },
  "subagents": {
    "contextManagementTools": true
  },
  "allowedUrls": [
    "https://docs.github.com",
    "https://www.chezmoi.io"
  ],
  "extraKnownMarketplaces": {
    "superpowers-marketplace": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers-marketplace"
      }
    }
  },
  "enabledPlugins": {
    "superpowers@superpowers-marketplace": true
  },
  "tabs": {
    "enabled": false
  },
  "sidebar": {
    "enabled": false
  },
  "scrollbar": false,
  "showReasoning": false,
  "mouse": false,
  "autoTier": "intelligence",
  "remoteExport": true,
  "remoteSessions": true
}
