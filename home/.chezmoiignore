# browser-harness shims — managed by `uv tool install browser-harness`,
# kept out of exact_bin so chezmoi does not remove them.
.local/bin/browser-harness
.local/bin/browser-harness-mcp

# Antigravity CLI (agy) — put there by its installer, which updates it.
.local/bin/agy

# fnm on Linux — put there by its installer (run_once_before_01-install-packages).
.local/bin/fnm

{{- if ne .chezmoi.os "darwin" }}
# The timeout wrapper only stands in for the GNU timeout macOS lacks; here it would shadow the real one.
.local/bin/timeout
# macOS-only application support (key bindings, Claude Desktop config); Linux has no Library.
Library
{{- end }}

# AWS — only config is managed; credentials and SSO token cache are never committed.
.aws/credentials
.aws/sso/
.aws/cli/cache/

# Work-only tools and configuration live in the separate work dotfiles checkout.
.local/bin/gcloud-login
.config/zsh/conf.d/ista/
.local/share/secrets/gitlab_token
.npmrc
