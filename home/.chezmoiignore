# Anthropic Claude CLI symlink — managed by https://claude.ai/install.sh,
# not chezmoi. Without this, exact_bin/ would remove it on apply.
.local/bin/claude

# browser-harness shims — managed by `uv tool install browser-harness`,
# same treatment as the Claude CLI above.
.local/bin/browser-harness
.local/bin/browser-harness-mcp

# Antigravity CLI (agy) — put there by its installer, which updates it.
.local/bin/agy

# fnm on Linux — put there by its installer (run_once_before_01-install-packages).
.local/bin/fnm

{{- if ne .chezmoi.os "darwin" }}
# The timeout wrapper only stands in for the GNU timeout macOS lacks; here it would shadow the real one.
.local/bin/timeout
# macOS-only application support (key bindings, Claude Desktop config); Linux has no Library.
Library
{{- end }}

# AWS — only config is managed; credentials and SSO token cache are never committed.
.aws/credentials
.aws/sso/
.aws/cli/cache/

{{- if ne .company "ista" }}
# gcloud-login skills describe the ista Google accounts only.
.agents/skills/gcloud-auth
.agents/skills/gcloud-login-automation
.claude/skills/gcloud-auth
.claude/skills/gcloud-login-automation
# These work-only tools/configs are deployed only for ista.
.local/bin/gcloud-login
.config/zsh/conf.d/ista/
{{- end }}

{{- if ne .company "ista" }}
# The GitLab token only exists in the work vault.
.local/share/secrets/gitlab_token
# The registry tokens too; the file holds nothing else.
.npmrc
{{- end }}
{{- if not .company }}
# No password manager without a context (the test container).
.local/share/secrets/context7_api_key
{{- end }}
