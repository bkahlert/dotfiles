# Autoload functions. fpath is deduplicated because `brew shellenv` exports
# FPATH, so a nested shell inherits these entries and would list each twice.
typeset -U fpath
fpath=($ZDOTDIR/functions $ZDOTDIR/completions $fpath)
autoload -Uz $ZDOTDIR/functions/*(N.:t)

# Source modular configs in order
for config in $ZDOTDIR/conf.d/*.zsh(N); do
  source "$config"
done

# Work-only modules are deployed only for ista by .chezmoiignore.
for config in $ZDOTDIR/conf.d/ista/*.zsh(N); do
  source "$config"
done

# Machine-local overrides (not managed by chezmoi)
[[ -f $ZDOTDIR/.zshrc.local ]] && source $ZDOTDIR/.zshrc.local
