{{ if and (eq .company "ista") (eq .chezmoi.os "darwin") -}}
# Scoped to gitlab.com only: a blanket "Host *" here would shadow the
# personal-key catch-all in ~/.ssh/config (KeePassXC via SSH_AUTH_SOCK),
# since Include (private_config line 6) runs before that catch-all.
Host gitlab.com
	IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
{{ end -}}
