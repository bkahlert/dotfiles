#!/usr/bin/env bash
# Purpose: Login startup script — starts the container machine, and on ista
#          machines keeps caffeinate active. (Package upgrades are handled
#          manually via the `upgrade-all` script, not on every login.)
# Usage: ~/.startup (invoked automatically by the startup LaunchAgent at login)

set -euo pipefail

[[ $(uname) == Darwin ]] || exit 0

# --- functions ---

# Prevent Mac from sleeping/locking.
# To stop manually: pkill -f "caffeinate -disu"
start_caffeinate() {
  # Kill any existing caffeinate processes
  pkill -f "caffeinate -disu" 2>/dev/null && echo "Killed existing caffeinate process"

  echo "Starting caffeinate to prevent system sleep..."
  caffeinate -disu &
  echo "Caffeinate started with PID: $!"
}

# Bring up the container VM. Podman is the only runtime that needs this:
# Docker Desktop starts its own VM with the app, and the `docker` wrapper in
# ~/.local/bin falls back to podman anyway, so this backs both names.
# `podman machine start` exits non-zero on an already-running machine, which
# under `set -e` would abort this script — hence the state check.
start_container_machine() {
  command -v podman >/dev/null || return 0

  local state
  if ! state=$(podman machine inspect --format '{{.State}}' 2>/dev/null); then
    echo "No podman machine to start (create one with: podman machine init)"
    return 0
  fi

  if [[ "$state" == running ]]; then
    echo "Podman machine already running"
    return 0
  fi

  echo "Starting podman machine (state: $state)..."
  if podman machine start; then
    echo "Podman machine started"
  else
    echo "Failed to start podman machine"
  fi
}

main() {
  echo "========================================="
  echo "Startup script started at: $(date)"
  echo "========================================="

  start_container_machine

  if [[ "${DOTFILES_CONTEXT:-}" == ista ]]; then
    start_caffeinate
  fi

  echo "========================================="
  echo "Startup script finished at: $(date)"
  echo "========================================="
}

# Run main and redirect output to log file, and to console if interactive
if [[ -t 1 ]]; then
  # Interactive - output to both console and log file
  main 2>&1 | tee -a "$HOME/.startup.log"
else
  # Non-interactive - only log to file
  main >> "$HOME/.startup.log" 2>&1
fi
